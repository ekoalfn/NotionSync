# ============================================================
# NotionSync / NowTrack -- environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# ---- Supabase ----------------------------------------------
# From Supabase dashboard -> Project Settings -> API
# Public values (also exposed to the browser via VITE_*)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Same Supabase URL/anon-key, but read on the SSR server
# (TanStack Start reads process.env on the server side)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-only: service role key -- BYPASSES RLS.
# Never expose to the client. Never commit. Rotate if leaked.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Notion ------------------------------------------------
# Optional first-boot fallback. After deploy, the Notion token
# is normally managed via Settings -> Notion (stored in DB).
NOTION_INTEGRATION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Runtime -----------------------------------------------
NODE_ENV=production
# Public URL of the deployment (used for OAuth/webhook callbacks)
PUBLIC_APP_URL=https://track.lamaraja.net
